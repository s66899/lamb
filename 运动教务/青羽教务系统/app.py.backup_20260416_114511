def load_data() -> dict:
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except:
            return create_default_data()
    return create_default_data()

def get_data() -> dict:
    """实时从文件读取数据确保多端同步"""
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except:
            pass
    return data

import threading

_data_lock = threading.Lock()

def read_data():
    """实时从文件读取数据"""
    global data
    with _data_lock:
        if os.path.exists(DATA_FILE):
            try:
                with open(DATA_FILE, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    return data
            except:
                pass
    return data

